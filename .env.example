# Copy to .env and fill in. Do not commit .env.

# Base URL of your Home Assistant instance (no trailing slash)
HA_URL=http://homeassistant.local:8123

# Long-lived access token from your HA user profile
HA_TOKEN=

# Public base URL this MCP server is reachable at (used for OAuth metadata)
MCP_PUBLIC_URL=http://localhost:8000

# Path the MCP endpoint is served on, e.g. mcp
MCP_PATH=mcp

# Bearer token clients must send to the MCP server
MCP_AUTH_TOKEN=
